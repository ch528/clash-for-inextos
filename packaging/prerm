#!/bin/sh
set -e

case "$1" in
  remove|deconfigure)
    systemctl stop inextos-clash-app-update.service >/dev/null 2>&1 || true
    systemctl stop inextos-clash-network-rollback.timer >/dev/null 2>&1 || true
    systemctl stop inextos-clash-mihomo.service >/dev/null 2>&1 || true
    systemctl disable --now inextos-clash.service >/dev/null 2>&1 || true
    systemctl disable --now inextos-clash-helper.service >/dev/null 2>&1 || true
    ;;
esac

exit 0
